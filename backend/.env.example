# Copiar a .env y completar. NUNCA commitear .env

# Base de datos (URL async):
#   Dev local (SQLite):            sqlite+aiosqlite:///./dev.db
#   Producción (PostgreSQL):       postgresql+asyncpg://usuario:clave@host:5432/limpieza
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Seguridad — generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS — orígenes del frontend separados por coma
CORS_ORIGINS=http://localhost:3000

# Cloudinary (opcional; si se dejan vacías se usa almacenamiento local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
